---
//Datos para cada componente
interface Props {
  title?: string;
  link?: string;
  variant?: "primary" | "outline";
  icon?: string;
  external?: boolean;
}

//Extraemos el dato title y content de la respuesta y si no hay, que muestre por defecto los valores
const { title = "Título por defecto" , link = "#", variant = "primary", icon, external = false } = Astro.props;

const styles = {
  primary: "bg-brand hover:bg-brand-dark text-white shadow-lg shadow-brand/25",
  outline: "border border-white/25 text-white hover:bg-white hover:text-ink-950",
};
---

<a href={link}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={`inline-flex items-center justify-center gap-2 font-semibold px-6 py-3.5 rounded-md transition-all duration-300 ${styles[variant]}`}
>
  {icon && <i class={icon}></i>}
  {title}
</a>
