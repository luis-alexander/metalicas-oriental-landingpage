---
import { projects } from '../../config/projects.json';
---

<div class="bg-ink-900 py-24 md:py-32 border-y border-white/5">
    <div class="mx-auto max-w-7xl px-6">
        <div data-aos="fade-up" class="text-center max-w-2xl mx-auto mb-20">
            <span class="eyebrow">Portafolio</span>
            <h2 class="font-display uppercase text-4xl md:text-6xl font-bold text-white mt-4">Proyectos realizados</h2>
            <p class="text-zinc-400 mt-4 text-lg">Algunos de los trabajos que hemos entregado a nuestros clientes.</p>
        </div>

        <div class="space-y-20 md:space-y-28">
            {
                projects.map((project, index)=> (
                    <article class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
                        <div data-aos={index % 2 === 0 ? "fade-right" : "fade-left"} class={index % 2 === 0 ? "" : "md:order-2"}>
                            <div class="relative group overflow-hidden rounded-lg border border-white/10 aspect-[4/3] bg-ink-800">
                                <img src={project.image} alt={project.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                                <span class="absolute top-0 left-0 font-display text-white text-lg font-bold bg-brand px-4 py-2">
                                    {String(index + 1).padStart(2, "0")}
                                </span>
                            </div>
                        </div>
                        <div data-aos="fade-up">
                            <p class="inline-flex items-center gap-2 text-sm text-zinc-300">
                                <i class="fa-solid fa-location-dot text-brand"></i>{project.ubicacion}
                            </p>
                            <h3 class="font-display uppercase text-3xl md:text-4xl font-bold text-white mt-3 leading-tight">{project.title}</h3>
                            <div class="w-12 h-0.5 bg-brand my-6"></div>
                            <p class="text-zinc-400 leading-relaxed">{project.description}</p>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</div>
