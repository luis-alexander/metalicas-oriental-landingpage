---
import Boton from "../Boton.astro";

const stats = [
  { value: "15+", label: "Años de experiencia" },
  { value: "5", label: "Ciudades atendidas" },
  { value: "100%", label: "Fabricación propia" },
];
---

<header class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Fondo -->
  <video
    class="absolute inset-0 w-full h-full object-cover"
    src="/videos/hero.mp4"
    poster="/videos/hero.jpg"
    autoplay muted loop playsinline preload="metadata"
    aria-hidden="true">
  </video>
  <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/85 to-ink-950/40"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-transparent to-transparent"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/70 to-black/30"></div>

  <div class="relative w-full mx-auto max-w-7xl px-6 pt-32 pb-24">
    <div data-aos="fade-up" class="max-w-3xl">
      <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-red-600">
      <span class="h-0.5 w-8 bg-red-600"></span>
      La puerta genuina
    </span>

    <h1 class="font-display uppercase font-bold text-white leading-[0.95] text-5xl sm:text-6xl md:text-7xl lg:text-5xl mt-6">
      Seguridad en acero,<br />
      <span class="text-red-600">hecha a su medida.</span>
    </h1>

    <p class="mt-8 text-lg md:text-xl text-zinc-300 leading-relaxed max-w-2xl">
      Fabricamos puertas de acero, portones y lanfords, instalamos cada proyecto con nuestro propio equipo y alquilamos andamios para su obra.
    </p>

      <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="https://wa.me/593991621748"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 rounded-lg bg-red-600 px-7 py-4 font-semibold text-white transition hover:bg-red-700"
      >
        <i class="fa-brands fa-whatsapp text-lg"></i>
        Solicitar cotización
      </a>

      <a
        href="#modelos"
        class="inline-flex items-center gap-3 rounded-lg border-2 border-white bg-black px-7 py-4 font-semibold text-white transition hover:bg-white hover:text-black"
      >
        Ver modelos
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
    </div>

    <!-- Cifras -->
    <div data-aos="fade-up" data-aos-delay="200" class="mt-20 grid grid-cols-3 gap-4 max-w-2xl">
      {stats.map((stat) => (
        <div class="rounded-lg bg-black border-l-4 border-red-600 p-4">
          <p class="font-display text-4xl md:text-5xl font-bold text-white">{stat.value}</p>
          <p class="text-xs sm:text-sm text-zinc-300 mt-1">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>

  <a href="#servicios" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-zinc-500 hover:text-white transition-colors animate-bounce" aria-label="Ir a servicios">
    <i class="fa-solid fa-chevron-down"></i>
  </a>
</header>
<script type="module" src="/js/scroll-hero.js"></script>
