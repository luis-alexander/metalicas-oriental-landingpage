---
const ciudades = ["Quito", "Latacunga", "Sigchos", "Machachi", "Tambillo"];

const valores = [
    { icon: "fa-solid fa-shield-halved", title: "Calidad garantizada", text: "Materiales de alta resistencia y acabados de primera." },
    { icon: "fa-solid fa-ruler-combined", title: "Hecho a medida", text: "Cada pieza se adapta a su fachada y necesidades." },
    { icon: "fa-solid fa-screwdriver-wrench", title: "Instalación propia", text: "Nuestro equipo instala y da seguimiento a cada obra." },
];
---

<div class="bg-ink-950 py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-16 items-center">
        <div data-aos="fade-right">
            <span class="eyebrow">Sobre nosotros</span>
            <h2 class="font-display uppercase text-4xl md:text-6xl font-bold text-white mt-4 leading-none">
                Más de 15 años<br />construyendo confianza
            </h2>
            <p class="text-zinc-400 text-lg leading-relaxed mt-6">
                En Metálicas Oriental fabricamos e instalamos productos metálicos con un compromiso claro: brindar la mejor calidad y servicio a nuestros clientes. Hemos llevado nuestro trabajo a hogares, comercios y obras en distintas ciudades del país.
            </p>

            <div class="mt-8">
                <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-3">Presencia en</p>
                <ul class="flex flex-wrap gap-2">
                    {ciudades.map((ciudad) => (
                        <li class="flex items-center gap-2 text-sm text-zinc-200 bg-white/5 border border-white/10 rounded-full px-4 py-1.5">
                            <i class="fa-solid fa-location-dot text-brand text-xs"></i>{ciudad}
                        </li>
                    ))}
                </ul>
            </div>

            <div class="mt-10 grid sm:grid-cols-3 gap-6">
                {valores.map((valor) => (
                    <div>
                        <div class="w-11 h-11 rounded-md bg-brand/10 text-brand flex items-center justify-center">
                            <i class={valor.icon}></i>
                        </div>
                        <h3 class="font-semibold text-white mt-4">{valor.title}</h3>
                        <p class="text-sm text-zinc-400 mt-1">{valor.text}</p>
                    </div>
                ))}
            </div>
        </div>

        <div data-aos="fade-left" class="relative">
            <div class="absolute -inset-4 bg-gradient-to-br from-brand/20 to-transparent rounded-2xl blur-2xl"></div>
            <div class="relative bg-white rounded-xl p-10 md:p-14 shadow-2xl">
                <img src="/images/logo-metalicas-oriental.png" alt="Metálicas Oriental - La puerta genuina" class="w-full max-w-md mx-auto" />
            </div>
            <div class="relative -mt-8 ml-8 mr-8 md:mr-auto md:max-w-xs bg-ink-800 border border-white/10 rounded-lg p-6 shadow-xl">
                <p class="font-display text-5xl font-bold text-white">15<span class="text-brand">+</span></p>
                <p class="text-sm text-zinc-400 mt-1">años fabricando la puerta genuina</p>
            </div>
        </div>
    </div>
</div>
