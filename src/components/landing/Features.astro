---
import features from '../../config/features.json';

const filtros = [
    { id: 'btn-todos', label: 'Todos' },
    { id: 'btn-puertas', label: 'Puertas' },
    { id: 'btn-portones', label: 'Portones' },
    { id: 'btn-lanford', label: 'Lanford' },
];
---

<div class="bg-ink-900 bg-grid py-24 md:py-32 border-y border-white/5">
    <div class="mx-auto max-w-7xl px-6">
        <div data-aos="fade-up" class="text-center max-w-2xl mx-auto">
            <span class="eyebrow">Catálogo</span>
            <h2 class="font-display uppercase text-4xl md:text-6xl font-bold text-white mt-4">Modelos disponibles</h2>
            <p class="text-zinc-400 mt-4 text-lg">Una selección de nuestros trabajos. Contáctenos para conocer más modelos, colores y medidas.</p>
        </div>

        <div data-aos="fade-up" class="flex flex-wrap justify-center gap-2 mt-10 mb-12">
            {filtros.map((filtro) => (
                <button id={filtro.id} class="filtro-btn text-sm font-semibold text-zinc-300 px-5 py-2.5 rounded-full border border-white/10 hover:border-white/30 hover:text-white transition-all">
                    {filtro.label}
                </button>
            ))}
        </div>

        <div id="modelos-container" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                features.map((feature) => (
                    <article class="modelo-item group bg-ink-800 rounded-lg overflow-hidden border border-white/5 hover:border-white/15" data-tipo={feature.tipo}>
                        {feature.imagen && (
                            <div class="relative overflow-hidden aspect-[4/3]">
                                {feature.imagen.endsWith('.mp4') ? (
                                    <video src={feature.imagen} poster={feature.imagen.replace('.mp4', '.jpg')} autoplay muted loop playsinline preload="none" aria-label={feature.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"></video>
                                ) : (
                                    <img src={feature.imagen} alt={feature.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                                )}
                                <span class="absolute top-4 left-4 bg-ink-950/80 backdrop-blur text-xs font-semibold uppercase tracking-wider text-white px-3 py-1 rounded-full">
                                    {feature.tipo}
                                </span>
                            </div>
                        )}
                        <div class="p-6">
                            <h3 class="font-display uppercase text-xl font-bold text-white">{feature.title}</h3>
                            <p class="text-sm text-zinc-400 mt-2">{feature.description}</p>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</div>
<!-- Script para filtro de proyectos, modelos, etc -->
<script type="module" src="/js/features.js"></script>


<style>
    .filtro-btn.active {
        background-color: #d71920;
        border-color: #d71920;
        color: #fff;
    }
    .modelo-item {
        transition: border-color 0.3s ease, opacity 0.3s ease;
    }
</style>
